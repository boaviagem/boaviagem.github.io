rules_version = '2';

// Regras de segurança do Firestore — app de comensais, com várias casas independentes.
//
// users/{uid} (comum a todas as casas): houseId, role, personId, email, gestor?
//   role 'admin'    → CL da casa (administra a casa)
//        'comensal' → gerencia as próprias refeições
//        'cozinha'  → Administradora: vê totais (só iniciais), cria Numerárias Auxiliares, manda mensagens
//        'auxiliar' → Numerária Auxiliar: mesma visão, sem criar contas nem mandar mensagens
//   gestor: true   → gestor geral: cria casas e contas de CL; NÃO lê os dados internos das casas
//
// houses/{casa}/...  → todos os dados de uma casa; só quem é da casa (users.houseId) tem acesso.
// A cozinha NÃO lê "names" (nomes completos e e-mails) nem "notes" (observações com autor).

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function myHouse() { return me().get('houseId', null); }
    function roleIs(r) { return hasProfile() && me().role == r; }
    function isGestor() { return hasProfile() && me().get('gestor', false) == true; }
    function sameHouse(data) { return hasProfile() && data.get('houseId', null) == myHouse(); }
    function noGestorFlag() { return request.resource.data.get('gestor', false) == false; }
    function bootstrapPath() { return /databases/$(db)/documents/settings/bootstrap; }
    function bootstrapping() { return !exists(bootstrapPath()) && getAfter(userPath()).data.get('gestor', false) == true; }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- Perfis de acesso ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isGestor()
        || (roleIs('admin') && sameHouse(resource.data))
        || (roleIs('cozinha') && sameHouse(resource.data) && resource.data.role == 'auxiliar'));
      // Gestor geral: qualquer conta (cria os CLs das casas)
      allow write: if isGestor();
      // CL: contas da própria casa (sem poder criar gestor)
      allow create: if roleIs('admin') && sameHouse(request.resource.data) && noGestorFlag();
      allow update: if roleIs('admin') && sameHouse(resource.data) && sameHouse(request.resource.data)
        && request.resource.data.get('gestor', false) == resource.data.get('gestor', false);
      allow delete: if roleIs('admin') && sameHouse(resource.data) && resource.data.get('gestor', false) == false;
      // Administradora: só Numerárias Auxiliares da própria casa
      allow create: if roleIs('cozinha') && sameHouse(request.resource.data) && noGestorFlag()
        && request.resource.data.role == 'auxiliar' && request.resource.data.personId == null;
      allow delete: if roleIs('cozinha') && sameHouse(resource.data) && resource.data.role == 'auxiliar';
      // Cada um pode apenas desligar o aviso de "trocar senha no primeiro acesso"
      allow update: if signedIn() && request.auth.uid == uid
        && onlyKeys(['mustChange']) && request.resource.data.mustChange == false;
      // Instalação nova: o primeiro usuário vira gestor e CL da casa "principal" (uma única vez)
      allow create: if signedIn() && request.auth.uid == uid && !exists(bootstrapPath()) && existsAfter(bootstrapPath())
        && request.resource.data.role == 'admin' && request.resource.data.gestor == true;
    }

    match /settings/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn() && bootstrapping() && request.resource.data.by == request.auth.uid;
    }

    // Dados do formato antigo (antes das casas): só o gestor lê, para migrá-los para uma casa
    match /{coll}/{id} {
      allow read: if isGestor() && coll in ['people', 'names', 'overrides', 'periods', 'notes', 'kitchenNotes',
        'dayNotes', 'messages', 'events', 'alerts', 'calls', 'daily', 'settings'];
    }

    // ---------- Casas ----------
    match /houses/{h} {
      function inH() { return hasProfile() && myHouse() == h; }
      function isAdmin() { return inH() && me().role == 'admin'; }       // CL
      function isChief() { return inH() && me().role == 'cozinha'; }     // Administradora
      function isKitchen() { return inH() && me().role in ['cozinha', 'auxiliar']; }
      function owns(pid) { return inH() && me().get('personId', null) == pid; }
      function noNote() { return request.resource.data.get('note', '') == ''; }

      // Nome da casa: os membros leem; só o gestor cria/altera
      allow read: if isGestor() || inH();
      allow create: if isGestor() || bootstrapping();
      allow update, delete: if isGestor();

      match /settings/{id} {
        allow read: if inH();
        allow write: if isAdmin();
      }

      // Comensais: iniciais, regime, regra padrão (sem nome completo)
      match /people/{pid} {
        allow read: if isAdmin() || isKitchen() || owns(pid);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (owns(pid) && onlyKeys(['defaultRule', 'birthday', 'updatedAt']));
      }

      // Nome completo e e-mail — invisíveis para a cozinha
      match /names/{pid} {
        allow read: if isAdmin() || owns(pid);
        allow write: if isAdmin();
      }

      // Alterações pontuais (por dia e refeição). A cozinha lê — por isso, sem observação aqui.
      match /overrides/{id} {
        allow read: if isAdmin() || isKitchen() || owns(resource.data.personId);
        allow create: if noNote() && (isAdmin() || owns(request.resource.data.personId));
        allow update: if noNote() && (isAdmin() || (owns(resource.data.personId) && owns(request.resource.data.personId)));
        allow delete: if isAdmin() || owns(resource.data.personId);
      }

      // Observações com autor: só CL e autor. O comensal não pode liberar a própria observação.
      match /notes/{id} {
        allow read: if isAdmin() || owns(resource.data.personId);
        allow create: if isAdmin() || (owns(request.resource.data.personId) && request.resource.data.approved == false
          && request.resource.data.get('kitchenId', null) == null);
        allow update: if isAdmin() || (owns(resource.data.personId) && owns(request.resource.data.personId)
          && request.resource.data.approved == false && request.resource.data.get('kitchenId', null) == null);
        allow delete: if isAdmin() || owns(resource.data.personId);
      }

      // Cópia ANÔNIMA (data, refeição, texto) das observações liberadas pelo CL: é o que a cozinha lê.
      // O autor pode apagar a cópia ao editar/apagar a própria observação (o id aleatório só ele e o CL conhecem).
      match /kitchenNotes/{id} {
        allow read: if isAdmin() || isKitchen();
        allow create, update: if isAdmin();
        allow delete: if inH();
      }

      // Regras temporárias (viagens, períodos especiais)
      match /periods/{id} {
        allow read: if isAdmin() || isKitchen() || owns(resource.data.personId);
        allow create: if isAdmin() || owns(request.resource.data.personId);
        allow update: if isAdmin() || (owns(resource.data.personId) && owns(request.resource.data.personId));
        allow delete: if isAdmin() || owns(resource.data.personId);
      }

      // Recados do CL para a cozinha, por dia (podem somar pessoas extras)
      match /dayNotes/{id} {
        allow read: if isAdmin() || isKitchen();
        allow write: if isAdmin();
      }

      // Mensagens: lado do CL (a2k) ⇄ lado da cozinha (k2a). Só a Administradora envia pela cozinha.
      match /messages/{id} {
        allow read: if isAdmin() || isKitchen();
        allow create: if (request.resource.data.from == request.auth.uid
          && ((isAdmin() && request.resource.data.dir == 'a2k') || (isChief() && request.resource.data.dir == 'k2a')))
          || isGestor(); // gestor: migração/cópia de mensagens de outros autores
        allow update: if onlyKeys(['readAt'])
          && ((isAdmin() && resource.data.dir == 'k2a') || (isChief() && resource.data.dir == 'a2k'));
        allow delete: if isAdmin();
      }

      // Churrasco: o CL informa participantes e público
      match /events/{id} {
        allow read: if inH();
        allow write: if isAdmin();
      }

      // Alertas para a cozinha: mudanças feitas depois do horário de aviso
      match /alerts/{id} {
        allow read: if isAdmin() || isKitchen();
        allow create: if (inH() && request.resource.data.by == request.auth.uid && request.resource.data.ackAt == null)
          || isGestor(); // gestor: migração
        allow update: if (isKitchen() || isAdmin()) && onlyKeys(['ackAt', 'ackBy']);
        allow delete: if isAdmin();
      }

      // Chamados da cozinha para o CL ("🔔 Chamar o CL")
      match /calls/{id} {
        allow read: if isAdmin() || isKitchen();
        allow create: if (isKitchen() && request.resource.data.by == request.auth.uid && request.resource.data.seenAt == null)
          || isGestor(); // gestor: migração
        allow update: if isAdmin() && onlyKeys(['seenAt', 'seenBy']);
        allow delete: if isAdmin();
      }

      // "Fotografia" diária dos totais, usada nas estatísticas
      match /daily/{date} {
        allow read: if isAdmin() || isKitchen();
        allow write: if isAdmin() || isKitchen();
      }
    }
  }
}
